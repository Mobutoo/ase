# Copy to .env for Docker Compose (Django itself does not load this file).
# Generate SECRET_KEY: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
POSTGRES_PASSWORD=
# Operator-approved origins only; no paths, trailing slash, or wildcard.
ICAL_ALLOWED_ORIGINS=
ADAPTER_ALLOWED_ORIGINS=
# Exact absolute paths to server-managed SuperProductivity exports, comma-separated.
ADAPTER_ALLOWED_FILES=
# Optional SSO
ZITADEL_ISSUER_URL=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
